.next/
node_modules/

# Never commit secrets. .env.local holds SUPABASE_SERVICE_ROLE_KEY, which
# bypasses every RLS policy in supabase/policies.sql. The previous rule
# matched only the literal name ".env.local", so a .env.production added
# later would have been committed.
.env
.env.*
!.env.example

# Dentrix exports read by /production on this computer only. The aging
# report holds patient names and birth dates, so this folder must never be
# committed or deployed.
/reports/
.next-check/
